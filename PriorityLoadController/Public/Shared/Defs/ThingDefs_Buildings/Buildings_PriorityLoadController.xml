<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<ThingDef ParentName="BuildingBase">
		<defName>TM_PriorityLoadController</defName>
		<label>priority load controller</label>
		<description>A power management unit that lets you assign priority levels to appliances connected to the same power grid. When supply runs short, lower-priority appliances are shut down first while critical equipment stays online.</description>
		<thingClass>Building</thingClass>
		<category>Building</category>
		<graphicData>
			<!-- Placeholder texture: reuses the vanilla power switch art until proper assets are produced. -->
			<texPath>Things/Building/Power/PowerSwitch</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>Transparent</shaderType>
			<damageData>
				<rect>(0.2,0.2,0.6,0.6)</rect>
			</damageData>
		</graphicData>
		<building>
			<ai_chillDestination>false</ai_chillDestination>
			<allowWireConnection>true</allowWireConnection>
		</building>
		<altitudeLayer>Building</altitudeLayer>
		<passability>Standable</passability>
		<leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
		<statBases>
			<MaxHitPoints>150</MaxHitPoints>
			<WorkToBuild>800</WorkToBuild>
			<Flammability>0.5</Flammability>
			<Beauty>-2</Beauty>
		</statBases>
		<costList>
			<Steel>40</Steel>
			<ComponentIndustrial>2</ComponentIndustrial>
		</costList>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>25</basePowerConsumption>
			</li>
			<li Class="CompProperties_Flickable" />
			<li Class="CompProperties_Breakdownable" />
			<li Class="TrueMogician.RimWorld.PriorityLoadController.Components.CompProperties_PriorityLoadController" />
		</comps>
		<rotatable>false</rotatable>
		<selectable>true</selectable>
		<tickerType>Normal</tickerType>
		<designationCategory>Power</designationCategory>
		<uiOrder>2015</uiOrder>
		<constructEffect>ConstructMetal</constructEffect>
		<researchPrerequisites>
			<li>Electricity</li>
		</researchPrerequisites>
	</ThingDef>

</Defs>